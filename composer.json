{
    "name": "php-io-extensions/imgdec",
    "type": "php-ext",
    "description": "PNG, JPEG and TIFF into straight RGBA8 in C, through libpng, libjpeg and libtiff",
    "keywords": [
        "png",
        "jpeg",
        "tiff",
        "image-decoding",
        "php-ext"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Project Saturn Studios, LLC",
            "email": "info@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        }
    },
    "php-ext": {
        "extension-name": "imgdec",
        "priority": 30,
        "support-zts": true,
        "support-nts": true,
        "os-families": [
            "linux",
            "darwin"
        ],
        "configure-options": [
            {
                "name": "enable-imgdec",
                "description": "PNG, JPEG and TIFF into straight RGBA8 in C, through libpng, libjpeg and libtiff",
                "needs-value": false
            }
        ]
    }
}
